// Copia este archivo como Secretos.xcconfig (no se sube a git) y rellena los valores.
// Ojo: en los .xcconfig "//" empieza un comentario, por eso las URL se escriben con $().

// Simulador con el backend en el mismo Mac (npm run dev):
URL_BACKEND = http:/$()/127.0.0.1:8787
// iPhone real: el backend desplegado en Cloudflare, por ejemplo:
// URL_BACKEND = https:/$()/dupe-finder.TU-SUBDOMINIO.workers.dev

// La misma CLAVE_APP que en backend/.dev.vars (o el secreto de Cloudflare).
CLAVE_APP =
