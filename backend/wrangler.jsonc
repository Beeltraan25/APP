{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dupe-finder",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// Versión web (carpeta web/ del repositorio): se sirve en la misma dirección que la API.
	// Las rutas /v1/* no existen como archivos, así que van al Worker.
	"assets": {
		"directory": "../web"
	},
	// Workers KV (plan gratuito): caché de 24 h y fotos temporales para Google Lens.
	// Los creó Wrangler en el primer despliegue (los id no son secretos).
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "faa5ef8614e7447ab98dd4c99d2e1dc3"
		},
		{
			"binding": "IMAGENES",
			"id": "c2b62e7aaa664e4ea1538256778b0170"
		}
	],
	// Límite de peticiones por instalación. Si tu plan no lo permitiera, quita este bloque:
	// el backend usa entonces un límite en memoria más sencillo.
	"ratelimits": [
		{
			"name": "LIMITADOR",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"vars": {
		// Modelos de Gemini en orden de preferencia: si el primero agota la cuota gratuita, se usa el siguiente.
		"GEMINI_MODELOS": "gemini-3.8-flash,gemini-3.5-flash-lite"
	},
	"observability": {
		"enabled": true
	}
}