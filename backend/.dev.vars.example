# Copia este archivo como .dev.vars y rellena los valores. .dev.vars nunca se sube a git.
# En producción se configuran con:  npx wrangler secret put NOMBRE

# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clave privada que comparten la app y el backend (inventa una larga, por ejemplo con: npx uuid)
CLAVE_APP=
